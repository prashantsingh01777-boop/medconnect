# Copy to .env and replace every example value. Never commit .env.
MEDCONNECT_DOMAIN=medconnect.example.com
ACME_EMAIL=operator@example.com
MEDCONNECT_SUPPORT_EMAIL=support@example.com
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MEDCONNECT_SECRET_KEY=replace-with-at-least-64-random-hex-characters
# Optional: required only if users should receive password-reset email.
MEDCONNECT_GMAIL_ADDRESS=
MEDCONNECT_GMAIL_APP_PASSWORD=
# Optional: enables caregiver alerts after an unconfirmed dose. Keep these secrets private.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# Configure an approved WhatsApp sender and a WhatsApp content template with variables 1-3.
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
# Panic location alerts need a separate approved WhatsApp template:
# variables 1=name, 2=Google Maps link, 3=sharing duration in minutes.
TWILIO_WHATSAPP_PANIC_CONTENT_SID=

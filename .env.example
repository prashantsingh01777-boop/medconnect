# Copy this file to .env and replace the required values before deployment.
# Never commit .env or put real credentials in this example file.

# Required by compose.yaml for the public HTTPS deployment.
MEDCONNECT_DOMAIN=medconnect.example.com
ACME_EMAIL=operator@example.com
MEDCONNECT_SUPPORT_EMAIL=support@example.com

# Generate a persistent secret with:
# python -c "import secrets; print(secrets.token_hex(32))"
# Use the same value after restarts; changing it signs out existing sessions.
MEDCONNECT_SECRET_KEY=replace-with-at-least-64-random-hex-characters

# Optional: user-composed email and password-reset email need both Gmail values.
# Use a Google App Password, not your Gmail account password.
MEDCONNECT_GMAIL_ADDRESS=
MEDCONNECT_GMAIL_APP_PASSWORD=

# User-composed SMS needs SID, token, and an SMS-capable sender number.
# Automatic caregiver SMS/WhatsApp alerts additionally need both WhatsApp values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
